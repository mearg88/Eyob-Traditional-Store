# ---------------------------------------------------------------------------
# WHICH KEYS ARE PUBLIC AND WHICH ARE SECRET
#
# Anything prefixed VITE_ is compiled into the JavaScript bundle and is
# readable by anyone who opens the site. Only ever put publishable keys there.
#
# Everything without the VITE_ prefix is read by serverless functions in
# /api and never reaches the browser. Chapa's secret key and Supabase's
# service role key MUST stay in this group — either one in the bundle would
# let a stranger take payments or read every customer's orders.
#
# With none of these set, the app runs in DEMO MODE: seeded catalogue,
# simulated payments, nothing leaves the machine.
# ---------------------------------------------------------------------------

# --- Public (safe in the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CHAPA_PUBLIC_KEY=
VITE_SITE_URL=http://localhost:5173

# --- Secret (serverless only, never VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# --- Cloudflare R2 (S3-compatible), serverless only ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eyob-store-media
R2_PUBLIC_BASE_URL=

# --- Email + owner notifications ---
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
